[Unit]
Description=csb — Crypto Scanner LIVE Telegram Control Bot
After=network-online.target
Wants=network-online.target

[Service]
User=psms
Group=psms
WorkingDirectory=/home/psms/ubuntu/program_files/csb
ExecStart=/home/psms/ubuntu/program_files/csb/venv/bin/python3 telegram_bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=csb-bot
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
