# .env holds SECRETS and the LIVE_ENABLED safety gate only.
#
# Every tunable (equity, intervals, risk caps, leverage, CSM/NASOS parameters,
# ML phase, notification toggles, log level) lives in data/settings.json and
# is hot-reloaded by the scanner — edit it from the dashboard Settings tab or
# the Telegram/Discord bots and it applies on the next cycle, no restart.
#
# Upgrading from an older .env that still carries those keys? Nothing to do:
# on first start data/settings.json is seeded from them automatically, and
# from then on the .env copies are ignored. The full list of keys, their
# types and bounds is modules/settings_manager.py (SPEC).

# ── Binance API Credentials ──────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Telegram control bot ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Discord control bot / notifier ────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

# ── Ngrok ─────────────────────────────────────────────────────────────────────
NGROK_AUTHTOKEN=

# ── Dashboard TOTP Secret (run dashboard_2fa_setup.py) ────────────────────────
DASHBOARD_TOTP_SECRET=

# ── Live Trading Gate ─────────────────────────────────────────────────────────
# Deliberately NOT editable from the dashboard. The bots can flip it (and
# restart the scanner); anything else is a manual edit on the server.
LIVE_ENABLED=false
