# ── Binance API Credentials ──────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Telegram Notifications ────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Discord Notifications ─────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

# ── Ngrok Configuration ───────────────────────────────────────────────────────
NGROK_AUTHTOKEN=
NGROK_ENABLED=false

# ── Machine Learning ──────────────────────────────────────────────────────────
ML_PHASE=2
ML_SHADOW=true

# ── Dashboard TOTP Secret ─────────────────────────────────────────────────────
DASHBOARD_TOTP_SECRET=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Live Trading Gate ─────────────────────────────────────────────────────────
LIVE_ENABLED=false
ACCOUNT_EQUITY_USDT=100.00

# ── Scanner Behaviour ─────────────────────────────────────────────────────────
SCAN_INTERVAL_SECONDS=60
FAST_INTERVAL_SECONDS=1
TOP_N_SYMBOLS=200
FOCUSED_MODE=true
FOCUSED_SIZE=150
MAX_ENTRIES_PER_CYCLE=1
MAX_CONCURRENT=5
MAX_TOTAL_MARGIN_PCT=0.9
GLOBAL_LEVERAGE=3
MAX_LEVERAGED_LOSS_PCT=0.10
MIN_COIN_AGE_DAYS=90
MAX_SL_PCT=0.10
CLOSE_ON_SHUTDOWN=false
MAX_PER_STRATEGY=CSM:2,NASOS_V4:2,ELLIOT_V8:1
MAX_TRADE_LOSS_PCT=0
MAX_RESUME_AGE_HOURS=12
MIN_STRENGTH=.50

# ── CSM Optimized Hybrid Configuration ────────────────────────────────────────
CSM_ALLOW_LONG=true
CSM_ALLOW_SHORT=true
CSM_MOM_LO=3.0
CSM_MOM_HI=4.0
CSM_SL_ATR_LONG=2.0
CSM_TP_ATR_LONG=4.0
CSM_SL_ATR_SHORT=2.0
CSM_TP_ATR_SHORT=4.0
CSM_MIN_SL_PCT=0.02
CSM_LEGACY_BE=false
CSM_PROFIT_LADDER=on
CSM_MAX_HOLD_MIN=1440
CSM_VOL_RATIO_MIN=1.0
